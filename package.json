{
  "name": "self-building-bot",
  "version": "0.6.1",
  "botCoreApi": 3,
  "botControllerProtocol": 2,
  "private": true,
  "type": "module",
  "description": "A durable conversation kernel with replaceable process applications.",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "bot": "./src/cli.mjs"
  },
  "scripts": {
    "setup": "node src/cli.mjs setup",
    "start": "node src/cli.mjs start",
    "test": "node --test --test-concurrency=2 test/*.test.mjs",
    "demo": "node src/cli.mjs demo"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "ajv": "8.17.1"
  },
  "botSetup": [
    "node",
    "apps/setup/main.mjs"
  ]
}
