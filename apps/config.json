{
  "appUpdates": "direct",
  "controller": "agent",
  "controllerProtocol": 2,
  "apps": {
    "agent": {
      "enabled": true,
      "hooks": {
        "prepare": [
          "bot-app",
          "context",
          "prepare",
          "--stdin"
        ],
        "complete": [
          "bot-app",
          "demo-model",
          "complete",
          "--stdin"
        ]
      },
      "services": [
        [
          "bot-app",
          "chat",
          "watch"
        ],
        [
          "bot-app",
          "scheduler",
          "watch"
        ]
      ]
    },
    "chat": {
      "enabled": true
    },
    "telegram": {
      "enabled": false
    },
    "memory": {
      "enabled": true
    },
    "context": {
      "enabled": true,
      "modelApp": "demo-model",
      "contributors": [
        "memory",
        "skills"
      ],
      "projections": [
        "chat"
      ]
    },
    "scheduler": {
      "enabled": true
    },
    "skills": {
      "enabled": true
    },
    "web-search": {
      "enabled": true
    },
    "updates": {
      "enabled": true
    },
    "demo-model": {
      "enabled": true
    },
    "model-provider": {
      "enabled": false
    },
    "terminal-chat": {
      "enabled": true,
      "adapter": [
        "bot-app",
        "chat",
        "acp"
      ]
    }
  },
  "clients": {
    "chat": [
      "node",
      "apps/terminal-chat/main.mjs",
      "chat"
    ],
    "acp": [
      "node",
      "apps/terminal-chat/main.mjs",
      "acp"
    ]
  }
}
